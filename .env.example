# Copy to .env locally. Never commit populated secret values.
JWT_SECRET=replace-with-a-random-secret-from-secrets-token-url-safe
GRAFANA_PASSWORD=replace-with-a-unique-strong-password
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Leave demo authentication disabled in production.
ENABLE_DEMO_AUTH=false
NEURALBLITZ_DEMO_USERS_JSON=
